[GENERAL]
DEVICE_TYPE=shellypro3em_old
THROTTLE_INTERVAL=0.0
ENABLE_WEB_SERVER=true

[CT002]
CT_MAC=
ACTIVE_CONTROL=true
MIN_EFFICIENT_POWER=0
EFFICIENCY_ROTATION_INTERVAL=900
MIN_DC_OUTPUT=0.0
GRID_PREDICT_TRUST=0.5
CLOUD_REPORTING=false

[HOMEASSISTANT]
IP=supervisor
PORT=80
API_PATH_PREFIX=/core
WAIT_FOR_NEXT_MESSAGE=true
POWER_CALCULATE=False
CURRENT_POWER_ENTITY=sensor.fake_power_meter
HAMPEL_WINDOW=6
HAMPEL_N_SIGMA=3.0
HAMPEL_MIN_THRESHOLD=25000.0
PID_KP=0.5
PID_MODE=bias

[MQTT_INSIGHTS]
BROKER=core-mosquitto
PORT=1883
USERNAME = REDACTED
PASSWORD = REDACTED
TLS=false
HA_DISCOVERY=True
ADDON_SLUG=3bc06276_b2500_meter
